/** miniprogram/pages/flashcard/flashcard.wxss **/

.page-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: var(--bg-canvas, #F8FAFC);
  overflow: hidden;
}

/* ==================== 1. 自定义顶部导航栏 ==================== */
.nav-bar {
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  background-color: #FFFFFF;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.nav-title-group {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nav-module-badge {
  padding: 4rpx 16rpx;
  background: var(--bg-surface-subtle, #F1F5F9);
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-secondary, #334155);
}

.nav-unit-text {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--text-muted, #64748B);
  margin-top: 4rpx;
  font-family: var(--font-mono);
}

.nav-placeholder {
  width: 160rpx; /* 留出微信胶囊的对称距离 */
}

/* 顶部进度条 */
.progress-track {
  width: 100%;
  height: 4rpx;
  background-color: var(--border-default, #E2E8F0);
}

.progress-fill {
  height: 100%;
  background-color: var(--color-primary, #0F172A);
  transition: width 0.3s ease;
}

/* ==================== 2. 核心单词主卡片 ==================== */
.card-wrapper {
  flex: 1;
  padding: 16rpx 32rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  perspective: 1200px;
  -webkit-perspective: 1200px;
  min-height: 0;
}

.flashcard {
  width: 100%;
  height: 100%;
  max-height: 980rpx;
  position: relative;
  transform-style: preserve-3d;
  -webkit-transform-style: preserve-3d;
  transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
}

.flashcard.flipped {
  transform: rotateY(180deg);
  -webkit-transform: rotateY(180deg);
}

/* 卡片正反面公共容器 */
.card-face {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: var(--bg-surface, #FFFFFF);
  border: 1rpx solid var(--border-default, #E2E8F0);
  border-radius: 24rpx;
  padding: 20rpx 28rpx 0;
  box-shadow: 0 6rpx 24rpx rgba(15, 23, 42, 0.05);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden; /* 由内部 scroll-view 负责垂直滚动，确保圆角与阴影不被破坏 */
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

/* 卡片内部独立原生滚动区域 */
.card-scroll-body {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
}

.card-scroll-inner {
  display: flex;
  flex-direction: column;
  padding-bottom: 56rpx;
  min-height: 100%;
  box-sizing: border-box;
}

/* 正面 */
.card-face-front {
  z-index: 2;
  transform: rotateY(0deg);
  -webkit-transform: rotateY(0deg);
  visibility: visible;
  opacity: 1;
  transition: opacity 0.2s ease, visibility 0.2s ease;
}

.flashcard.flipped .card-face-front {
  visibility: hidden;
  opacity: 0;
  pointer-events: none;
  transition-delay: 0.16s;
}

/* 反面 */
.card-face-back {
  z-index: 1;
  transform: rotateY(180deg);
  -webkit-transform: rotateY(180deg);
  visibility: hidden;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease, visibility 0.2s ease;
}

.flashcard.flipped .card-face-back {
  visibility: visible;
  opacity: 1;
  pointer-events: auto;
  transition-delay: 0.16s;
}

/* 终端小顶栏 */
.terminal-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--bg-surface-subtle, #F1F5F9);
  flex-shrink: 0;
}

.mac-dots {
  display: flex;
  gap: 10rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.dot-red { background-color: #EF4444; }
.dot-yellow { background-color: #F59E0B; }
.dot-green { background-color: #10B981; }

.terminal-bar-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.spec-tag {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--text-muted, #64748B);
  font-family: var(--font-mono);
}

.mode-pill {
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

.mode-front {
  background: var(--bg-surface-subtle, #F1F5F9);
  color: var(--text-secondary, #475569);
  border: 1rpx solid var(--border-default, #E2E8F0);
}

.mode-back {
  background: #ECFDF5;
  color: #059669;
  border: 1rpx solid #A7F3D0;
}

/* 单词大标题区 */
.word-hero {
  padding: 18rpx 0 14rpx;
  flex-shrink: 0;
}

.word-hero-compact {
  padding: 10rpx 0 8rpx;
}

.word-text {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--text-primary, #0F172A);
  font-family: var(--font-mono);
  letter-spacing: -0.5rpx;
}

.word-text-compact {
  font-size: 42rpx;
}

.phonetic-row {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.phonetic-text {
  font-size: 26rpx;
  color: var(--text-muted, #64748B);
  font-family: var(--font-mono);
  margin-right: 16rpx;
}

.pos-badge {
  padding: 4rpx 12rpx;
  background: var(--bg-surface-subtle, #F1F5F9);
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--text-secondary, #475569);
  margin-right: 16rpx;
}

.audio-btn {
  width: 44rpx;
  height: 44rpx;
  background: var(--bg-surface-subtle, #F1F5F9);
  border: 1rpx solid var(--border-default, #E2E8F0);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.speaker-icon {
  width: 0;
  height: 0;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-right: 12rpx solid var(--text-secondary, #334155);
  position: relative;
}

.speaker-icon::after {
  content: '';
  position: absolute;
  left: -8rpx;
  top: -4rpx;
  width: 6rpx;
  height: 8rpx;
  background-color: var(--text-secondary, #334155);
}

.audio-btn.playing {
  background: #0F172A;
  border-color: #0F172A;
  animation: audioPulse 1.2s infinite ease-in-out;
}

.audio-btn.playing .speaker-icon {
  border-right-color: #FFFFFF;
}

.audio-btn.playing .speaker-icon::after {
  background-color: #FFFFFF;
}

@keyframes audioPulse {
  0% {
    box-shadow: 0 0 0 0 rgba(15, 23, 42, 0.4);
  }
  70% {
    box-shadow: 0 0 0 14rpx rgba(15, 23, 42, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(15, 23, 42, 0);
  }
}

/* 典型工程语境栏与朗读按钮 */
.context-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.context-audio-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: #F1F5F9;
  border: 1rpx solid #CBD5E1;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  color: #475569;
  transition: all 0.2s ease;
}

.context-audio-pill.playing {
  background: #0F172A;
  color: #FFFFFF;
  border-color: #0F172A;
  animation: audioPulse 1.4s infinite ease-in-out;
}

.mini-audio-icon {
  font-size: 20rpx;
}

.mini-audio-text {
  font-size: 20rpx;
  font-weight: 500;
}

/* 计算机专属释义区 */
.definition-card {
  background: var(--bg-canvas, #F8FAFC);
  border: 1rpx solid var(--border-default, #E2E8F0);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 12rpx;
  flex-shrink: 0;
}

/* 双轨释义卡片 (生活常释 vs 计算机专属) */
.dual-def-card {
  background: var(--bg-canvas, #F8FAFC);
  border: 1rpx solid var(--border-default, #E2E8F0);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 14rpx;
}

.def-dual-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.def-badge {
  font-size: 19rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.badge-general {
  background: #EFF6FF;
  color: #1D4ED8;
  border: 1rpx solid #BFDBFE;
}

.badge-tech {
  background: var(--color-primary, #0F172A);
  color: #FFFFFF;
}

.def-text-general {
  font-size: 25rpx;
  line-height: 38rpx;
  color: var(--text-secondary, #475569);
  font-weight: 500;
  flex: 1;
}

.def-inner-divider {
  height: 1rpx;
  background-color: var(--border-default, #E2E8F0);
  margin: 14rpx 0;
}

.def-tech-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.def-main {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text-primary, #0F172A);
}

.def-detail {
  font-size: 24rpx;
  line-height: 36rpx;
  color: var(--text-secondary, #475569);
}

.def-context {
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed var(--border-subtle, #CBD5E1);
  font-size: 22rpx;
  display: flex;
  flex-wrap: wrap;
}

.context-label {
  color: var(--text-muted, #64748B);
}

.context-content {
  color: var(--text-primary, #0F172A);
  font-weight: 600;
}

/* 设计隐喻卡片 (一句话连接生活到技术的具象心智模型) */
.metaphor-card {
  background: #F0FDF4;
  border: 1rpx solid #BBF7D0;
  border-left: 6rpx solid var(--color-success, #059669);
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  margin-top: 16rpx;
  flex-shrink: 0;
}

.metaphor-header {
  margin-bottom: 8rpx;
}

.metaphor-badge {
  font-size: 19rpx;
  font-weight: 800;
  color: var(--color-success, #059669);
  background: #FFFFFF;
  border: 1rpx solid #A7F3D0;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  display: inline-block;
}

.metaphor-text {
  font-size: 24rpx;
  line-height: 40rpx;
  color: #166534;
  font-weight: 500;
  display: block;
}

/* 真实代码与工程例句终端 */
.code-terminal {
  background: var(--bg-canvas, #F8FAFC);
  border: 1rpx solid var(--border-default, #E2E8F0);
  border-radius: 16rpx;
  overflow: hidden;
  margin-top: 16rpx;
  flex-shrink: 0;
}

.code-titlebar {
  background: var(--bg-surface-subtle, #F1F5F9);
  padding: 10rpx 20rpx;
  border-bottom: 1rpx solid var(--border-default, #E2E8F0);
}

.code-filename {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--text-muted, #64748B);
  font-family: var(--font-mono);
}

.code-content {
  padding: 16rpx 20rpx;
  font-family: var(--font-mono);
  font-size: 22rpx;
}

.code-line {
  display: flex;
  line-height: 38rpx;
}

.line-num {
  width: 44rpx;
  color: var(--text-subtle, #94A3B8);
  flex-shrink: 0;
}

.line-text {
  color: var(--text-body, #334155);
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.line-text.comment {
  color: var(--text-muted, #64748B);
}

.token-highlight {
  background-color: var(--color-primary, #0F172A);
  color: #FFFFFF;
  font-weight: 700;
  padding: 0 8rpx;
  border-radius: 6rpx;
  margin: 0 4rpx;
}

.token-green {
  color: var(--color-success, #059669);
  font-weight: 600;
}

/* ==================== 2A & 2B. 正反面专属视觉组件 ==================== */

/* 正面主动回忆线索卡片 */
.recall-box {
  background: var(--bg-canvas, #F8FAFC);
  border: 1rpx solid var(--border-default, #E2E8F0);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 20rpx;
  flex-shrink: 0;
}

.recall-header {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.recall-tag {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--color-primary, #0F172A);
  background: #FFFFFF;
  border: 1rpx solid var(--border-default, #E2E8F0);
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.recall-body {
  font-size: 24rpx;
  margin-bottom: 16rpx;
  line-height: 38rpx;
}

.recall-label {
  color: var(--text-muted, #64748B);
}

.recall-val {
  color: var(--text-primary, #0F172A);
  font-weight: 600;
  font-family: var(--font-mono);
}

.recall-prompt {
  font-size: 24rpx;
  line-height: 38rpx;
  border-top: 1rpx dashed var(--border-default, #E2E8F0);
  padding-top: 14rpx;
}

.prompt-text {
  font-size: 23rpx;
  color: var(--text-secondary, #475569);
}

/* 正面翻转行动引导条 (CTA) */
.flip-cta-box {
  margin-top: auto;
  padding-top: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.flip-cta-btn {
  width: 100%;
  height: 84rpx;
  background: var(--bg-surface-subtle, #F1F5F9);
  border: 1rpx dashed var(--border-subtle, #CBD5E1);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.02);
}

.flip-rotate-icon {
  width: 20rpx;
  height: 20rpx;
  border: 3.5rpx solid var(--text-secondary, #334155);
  border-top-color: transparent;
  border-radius: 50%;
  transform: rotate(30deg);
}

.flip-cta-text {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--text-secondary, #334155);
}

.flip-subtext {
  font-size: 19rpx;
  color: var(--text-subtle, #94A3B8);
  font-family: var(--font-mono);
}

/* 反面翻回正面提示条 */
.flip-back-bar {
  margin-top: 28rpx;
  padding: 16rpx 0 24rpx 0;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  flex-shrink: 0;
  cursor: pointer;
}

.flip-back-bar:active {
  opacity: 0.65;
}

.flip-back-icon {
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid var(--text-muted, #64748B);
  border-top-color: transparent;
  border-radius: 50%;
  transform: rotate(-45deg);
}

.flip-back-text {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-muted, #64748B);
}

/* ==================== 3. 底部三态熟练度操作栏 ==================== */
.action-toolbar {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  height: 104rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: transform 0.1s ease, opacity 0.1s ease;
}

.btn-hover {
  transform: scale(0.97);
  opacity: 0.9;
}

.btn-danger {
  background-color: var(--color-danger-bg, #FFF1F2);
  border: 1rpx solid #FECDD3;
}

.btn-danger .btn-text {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-danger, #E11D48);
}

.btn-danger .shortcut-key {
  font-size: 18rpx;
  font-weight: 600;
  color: #FDA4AF;
  font-family: var(--font-mono);
  margin-top: 4rpx;
}

.btn-warning {
  background-color: var(--color-warning-bg, #FFFBEB);
  border: 1rpx solid #FDE68A;
}

.btn-warning .btn-text {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-warning, #D97706);
}

.btn-warning .shortcut-key {
  font-size: 18rpx;
  font-weight: 600;
  color: #FCD34D;
  font-family: var(--font-mono);
  margin-top: 4rpx;
}

.btn-success {
  background-color: var(--color-primary, #0F172A);
  border: 1rpx solid var(--color-primary, #0F172A);
}

.btn-success .btn-text {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-primary-text, #FFFFFF);
}

.btn-success .shortcut-key {
  font-size: 18rpx;
  font-weight: 600;
  color: var(--text-muted, #64748B);
  font-family: var(--font-mono);
  margin-top: 4rpx;
}

/* ==================== 4. 底部引导文案 & 安全区 ==================== */
.footer-area {
  padding: 10rpx 32rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.gesture-hint {
  font-size: 22rpx;
  color: var(--text-subtle, #94A3B8);
  margin-bottom: 16rpx;
}

.home-indicator {
  width: 270rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background-color: var(--border-subtle, #CBD5E1);
}

/* ==================== 5. 单元通关结算弹窗 ==================== */
.completion-mask {
  position: fixed;
  inset: 0;
  background-color: rgba(15, 23, 42, 0.6);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.completion-mask.visible {
  opacity: 1;
  pointer-events: auto;
}

.completion-card {
  width: 100%;
  max-width: 640rpx;
  background-color: #FFFFFF;
  border: 1rpx solid var(--border-default, #E2E8F0);
  border-radius: 28rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 16rpx 48rpx rgba(15, 23, 42, 0.15);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.completion-badge {
  display: inline-block;
  padding: 8rpx 24rpx;
  background-color: var(--color-success-bg, #ECFDF5);
  color: var(--color-success, #059669);
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.completion-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-primary, #0F172A);
  margin-bottom: 32rpx;
}

.completion-stats-row {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-around;
  background-color: var(--bg-canvas, #F8FAFC);
  border: 1rpx solid var(--border-default, #E2E8F0);
  border-radius: 20rpx;
  padding: 24rpx 12rpx;
  margin-bottom: 24rpx;
}

.stat-box {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 800;
  font-family: var(--font-mono);
}

.stat-sub {
  font-size: 22rpx;
  color: var(--text-muted, #64748B);
  margin-top: 4rpx;
}

.text-success { color: var(--color-success, #059669); }
.text-warning { color: var(--color-warning, #D97706); }
.text-danger { color: var(--color-danger, #E11D48); }

.completion-hint {
  font-size: 22rpx;
  color: var(--text-muted, #64748B);
  line-height: 36rpx;
  margin-bottom: 32rpx;
}

.completion-actions {
  width: 100%;
  display: flex;
  gap: 20rpx;
}

.comp-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
}

.comp-btn.btn-secondary {
  background-color: var(--bg-canvas, #F8FAFC);
  border: 1rpx solid var(--border-default, #E2E8F0);
  color: var(--text-secondary, #334155);
}

.comp-btn.btn-primary {
  background-color: var(--color-primary, #0F172A);
  color: #FFFFFF;
}

/* ==================== 2C. 单元尾声客观真测大挑战样式 (选项2) ==================== */
.quiz-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 16rpx 36rpx 40rpx;
  box-sizing: border-box;
  animation: quizSlideIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.quiz-card {
  background-color: var(--bg-surface, #FFFFFF);
  border: 1rpx solid var(--border-default, #E2E8F0);
  border-radius: 28rpx;
  padding: 32rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(15, 23, 42, 0.06);
  display: flex;
  flex-direction: column;
}

.quiz-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.quiz-badge-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.quiz-stage-tag {
  background: var(--color-primary, #0F172A);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.quiz-progress-text {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-primary, #0F172A);
  font-family: var(--font-mono);
}

.quiz-subhint {
  font-size: 20rpx;
  color: var(--text-muted, #64748B);
}

.quiz-progress-bar {
  width: 100%;
  height: 6rpx;
  background: var(--bg-surface-subtle, #F1F5F9);
  border-radius: 3rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.quiz-progress-fill {
  height: 100%;
  background: var(--color-primary, #0F172A);
  transition: width 0.3s ease;
}

/* 场景题干 (大字排版，纯自然语言无代码) */
.quiz-scenario-box {
  background: var(--bg-canvas, #F8FAFC);
  border: 1rpx solid var(--border-default, #E2E8F0);
  border-left: 6rpx solid var(--color-primary, #0F172A);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.scenario-tag {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-muted, #64748B);
  margin-bottom: 8rpx;
}

.scenario-text {
  font-size: 27rpx;
  line-height: 44rpx;
  color: var(--text-primary, #0F172A);
  font-weight: 600;
  letter-spacing: 0.3rpx;
  display: block;
}

/* 4 选 1 选项卡片 */
.quiz-options-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.quiz-option-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 1.5rpx solid var(--border-default, #E2E8F0);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  transition: all 0.2s ease;
  cursor: pointer;
}

.quiz-option-item:active {
  background: var(--bg-surface-subtle, #F1F5F9);
}

.quiz-option-item.selected {
  border-color: var(--color-primary, #0F172A);
  background: var(--bg-canvas, #F8FAFC);
}

.option-label-circle {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--bg-surface-subtle, #F1F5F9);
  color: var(--text-secondary, #475569);
  font-size: 22rpx;
  font-weight: 800;
  font-family: var(--font-mono);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.option-text {
  font-size: 26rpx;
  color: var(--text-primary, #0F172A);
  font-weight: 600;
  flex: 1;
  line-height: 36rpx;
}

.option-result-icon {
  font-size: 28rpx;
  font-weight: 800;
  margin-left: 16rpx;
}

/* 选项状态判定颜色 */
.quiz-option-item.correct {
  background: #F0FDF4 !important;
  border-color: #86EFAC !important;
}

.quiz-option-item.correct .option-label-circle {
  background: var(--color-success, #059669);
  color: #FFFFFF;
}

.quiz-option-item.correct .option-text {
  color: #166534;
}

.quiz-option-item.correct .option-result-icon {
  color: var(--color-success, #059669);
}

.quiz-option-item.wrong {
  background: #FEF2F2 !important;
  border-color: #FECACA !important;
}

.quiz-option-item.wrong .option-label-circle {
  background: var(--color-danger, #E11D48);
  color: #FFFFFF;
}

.quiz-option-item.wrong .option-text {
  color: #991B1B;
}

.quiz-option-item.wrong .option-result-icon {
  color: var(--color-danger, #E11D48);
}

.quiz-option-item.dimmed {
  opacity: 0.55;
}

/* 答题反馈气泡 */
.quiz-feedback-card {
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  animation: feedbackFadeIn 0.25s ease-out;
}

.quiz-feedback-card.feedback-correct {
  background: #F0FDF4;
  border: 1rpx solid #BBF7D0;
}

.quiz-feedback-card.feedback-wrong {
  background: #FEF2F2;
  border: 1rpx solid #FECACA;
}

.feedback-status-title {
  font-size: 24rpx;
  font-weight: 800;
  display: block;
  margin-bottom: 8rpx;
}

.feedback-correct .feedback-status-title {
  color: #166534;
}

.feedback-wrong .feedback-status-title {
  color: #991B1B;
}

.feedback-explanation {
  font-size: 23rpx;
  line-height: 38rpx;
  color: var(--text-secondary, #475569);
  display: block;
}

.quiz-next-bar {
  margin-top: 10rpx;
}

.quiz-next-btn {
  width: 100%;
  height: 84rpx;
  background: var(--color-primary, #0F172A);
  color: #FFFFFF;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  transition: opacity 0.2s ease;
}

.quiz-next-btn:active {
  opacity: 0.85;
}

@keyframes quizSlideIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes feedbackFadeIn {
  from { opacity: 0; transform: translateY(-6rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ==================== 5. 单元结算真验明细看板 ==================== */
.quiz-score-banner {
  width: 100%;
  background: var(--bg-canvas, #F8FAFC);
  border: 1rpx solid var(--border-default, #E2E8F0);
  border-left: 6rpx solid var(--color-warning, #D97706);
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  text-align: left;
}

.quiz-score-banner.score-perfect {
  border-left-color: var(--color-success, #059669);
  background: #F0FDF4;
}

.score-main-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.score-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-primary, #0F172A);
}

.score-value {
  font-size: 26rpx;
  font-weight: 800;
  font-family: var(--font-mono);
  color: var(--color-primary, #0F172A);
}

.score-desc {
  font-size: 21rpx;
  line-height: 34rpx;
  color: var(--text-secondary, #475569);
}

.verified-list-box {
  width: 100%;
  margin-bottom: 28rpx;
  text-align: left;
}

.verified-list-title {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-muted, #64748B);
  margin-bottom: 12rpx;
}

.verified-tags-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.v-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  font-size: 21rpx;
}

.v-tag-pass {
  background: #F0FDF4;
  border: 1rpx solid #BBF7D0;
  color: #166534;
}

.v-tag-fail {
  background: #FEF2F2;
  border: 1rpx solid #FECACA;
  color: #991B1B;
}

.v-word {
  font-weight: 700;
  font-family: var(--font-mono);
}

.v-mark {
  font-size: 19rpx;
  opacity: 0.9;
}

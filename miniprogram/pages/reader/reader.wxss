/** miniprogram/pages/reader/reader.wxss **/
/* 文章分类页面样式 (Clean Light 极简浅色设计规范) */

.page-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #F8FAFC;
  overflow: hidden;
  position: relative;
}

/* ==================== 1. 自定义顶部导航栏 ==================== */
.reader-nav {
  width: 100%;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #F1F5F9;
  z-index: 10;
  flex-shrink: 0;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.nav-title-box {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.nav-main-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #0F172A;
  letter-spacing: -0.5rpx;
}

.nav-sub-title {
  font-size: 22rpx;
  color: #64748B;
  font-weight: 500;
}

.nav-capsule-spacer {
  width: 170rpx; /* 微信胶囊占位 */
}

/* ==================== 2. 主体滚动区 ==================== */
.content-scroll {
  flex: 1;
  height: 0;
}

.scroll-inner {
  padding: 24rpx 32rpx;
}

/* ==================== 2.1 「继续上次阅读」快速直达卡片 ==================== */
.hero-last-read {
  background: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  border-radius: 24rpx;
  padding: 28rpx 32rpx 28rpx 36rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
  position: relative;
  overflow: hidden;
  margin-bottom: 24rpx;
  transition: all 0.2s ease;
}

.card-hover {
  transform: scale(0.985);
  opacity: 0.95;
}

.hero-active-bar {
  position: absolute;
  left: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 8rpx;
  background: #0F172A;
  border-radius: 0 4rpx 4rpx 0;
}

.hero-inner {
  display: flex;
  flex-direction: column;
}

.hero-status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.hero-badges {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.hero-tag-last {
  background: #F1F5F9;
  color: #475569;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.hero-tag-progress {
  background: #FFFBEB;
  color: #D97706;
  border: 1rpx solid #FDE68A;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.hero-time-text {
  font-size: 22rpx;
  color: #94A3B8;
}

.hero-article-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #0F172A;
  line-height: 1.35;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-article-meta {
  font-size: 22rpx;
  color: #64748B;
  margin-bottom: 24rpx;
}

.hero-bottom-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28rpx;
}

.hero-bar-track {
  flex: 1;
  height: 10rpx;
  background: #F1F5F9;
  border-radius: 5rpx;
  overflow: hidden;
}

.hero-bar-fill {
  height: 100%;
  background: #0F172A;
  border-radius: 5rpx;
  transition: width 0.3s ease;
}

.hero-cta-btn {
  background: #0F172A;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  padding: 12rpx 28rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 10rpx rgba(15, 23, 42, 0.15);
}

/* ==================== 2.2 搜索栏 ==================== */
.search-container {
  margin-bottom: 24rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  border-radius: 20rpx;
  padding: 14rpx 24rpx;
  gap: 16rpx;
}

.search-icon {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #94A3B8;
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
}

.search-icon::after {
  content: '';
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 10rpx;
  height: 3rpx;
  background: #94A3B8;
  transform: rotate(45deg);
  border-radius: 2rpx;
}

.search-input {
  flex: 1;
  font-size: 24rpx;
  color: #0F172A;
}

.input-placeholder {
  color: #94A3B8;
  font-size: 24rpx;
}

.clear-btn {
  font-size: 24rpx;
  color: #94A3B8;
  padding: 4rpx 10rpx;
}

/* ==================== 2.3 区域标题 ==================== */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #0F172A;
}

.section-badge {
  background: #EFF6FF;
  color: #2563EB;
  font-size: 20rpx;
  font-weight: 700;
  padding: 2rpx 14rpx;
  border-radius: 12rpx;
}

.section-right {
  font-size: 22rpx;
  color: #94A3B8;
}

/* ==================== 2.4 分类卡片流 ==================== */
.categories-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.category-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.03);
  transition: all 0.15s ease;
}

.cat-icon-box {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  border: 1rpx solid;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
}

/* 自定义领域图标 */
.custom-icon {
  width: 44rpx;
  height: 44rpx;
  position: relative;
}

/* 网络拓扑图标 */
.icon-net::before, .icon-net::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  background: #2563EB;
}
.icon-net::before {
  width: 14rpx;
  height: 14rpx;
  top: 4rpx;
  left: 15rpx;
}
.icon-net::after {
  width: 12rpx;
  height: 12rpx;
  bottom: 6rpx;
  left: 6rpx;
  box-shadow: 20rpx 0 0 #2563EB;
}

/* CPU / 锁图标 */
.icon-cpu::before {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #D97706;
  border-radius: 6rpx;
}
.icon-cpu::after {
  content: '';
  position: absolute;
  top: 17rpx;
  left: 17rpx;
  width: 8rpx;
  height: 8rpx;
  background: #D97706;
  border-radius: 50%;
}

/* 集群图标 */
.icon-cluster::before, .icon-cluster::after {
  content: '';
  position: absolute;
  background: #9333EA;
  border-radius: 4rpx;
}
.icon-cluster::before {
  top: 6rpx;
  left: 6rpx;
  width: 14rpx;
  height: 14rpx;
  box-shadow: 18rpx 0 0 #9333EA;
}
.icon-cluster::after {
  bottom: 6rpx;
  left: 15rpx;
  width: 14rpx;
  height: 14rpx;
}

/* 存储柱状图标 */
.icon-db::before, .icon-db::after {
  content: '';
  position: absolute;
  left: 10rpx;
  width: 24rpx;
  border: 3rpx solid #059669;
  border-radius: 50%;
}
.icon-db::before {
  top: 6rpx;
  height: 10rpx;
}
.icon-db::after {
  bottom: 8rpx;
  height: 10rpx;
  border-top: none;
}

/* 云朵图标 */
.icon-cloud::before {
  content: '☁';
  position: absolute;
  font-size: 32rpx;
  color: #475569;
  top: 2rpx;
  left: 6rpx;
}

.cat-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.cat-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.cat-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #0F172A;
}

.cat-tag {
  background: #F1F5F9;
  color: #475569;
  font-size: 18rpx;
  font-weight: 600;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.cat-desc {
  font-size: 22rpx;
  color: #64748B;
  margin-top: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cat-action {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.cat-ratio {
  font-size: 24rpx;
  font-weight: 700;
}

.cat-chevron {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid #94A3B8;
  border-right: 3rpx solid #94A3B8;
  transform: rotate(45deg);
}

.empty-state {
  padding: 60rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 24rpx;
  color: #94A3B8;
}

.bottom-spacer {
  height: 40rpx;
}

/* ==================== 3. 底部 4-Tab 导航栏 ==================== */
.tab-bar {
  display: flex;
  align-items: center;
  height: 168rpx;
  background-color: #FFFFFF;
  border-top: 1rpx solid #E2E8F0;
  padding-bottom: env(safe-area-inset-bottom, 40rpx);
  flex-shrink: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  height: 100%;
}

.tab-indicator {
  position: absolute;
  top: 16rpx;
  width: 60rpx;
  height: 6rpx;
  background-color: #0F172A;
  border-radius: 3rpx;
}

.tab-icon {
  width: 44rpx;
  height: 40rpx;
  margin-bottom: 6rpx;
  position: relative;
}

.icon-learn {
  border: 3.5rpx solid #94A3B8;
  border-radius: 6rpx;
  width: 36rpx;
  height: 32rpx;
  margin: 0 auto;
}

.icon-read {
  width: 36rpx;
  height: 32rpx;
  border: 3.5rpx solid #94A3B8;
  border-radius: 6rpx;
  margin: 0 auto;
}

.icon-read.active {
  background-color: #0F172A;
  border-color: #0F172A;
}

.icon-notebook {
  width: 36rpx;
  height: 32rpx;
  border: 3.5rpx solid #94A3B8;
  border-radius: 6rpx;
  margin: 0 auto;
  position: relative;
}

.icon-notebook::after {
  content: 'A';
  position: absolute;
  font-size: 20rpx;
  font-weight: 700;
  color: #94A3B8;
  top: 2rpx;
  left: 8rpx;
}

.badge-dot {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background-color: #E11D48;
}

.icon-profile {
  width: 36rpx;
  height: 32rpx;
  margin: 0 auto;
  position: relative;
}

.icon-profile::before {
  content: '';
  position: absolute;
  top: 2rpx;
  left: 10rpx;
  width: 14rpx;
  height: 14rpx;
  border: 3.5rpx solid #94A3B8;
  border-radius: 50%;
}

.icon-profile::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 4rpx;
  width: 26rpx;
  height: 10rpx;
  border: 3.5rpx solid #94A3B8;
  border-bottom: none;
  border-radius: 12rpx 12rpx 0 0;
}

.tab-text {
  font-size: 20rpx;
  font-weight: 500;
  color: #64748B;
}

.tab-text.active {
  color: #0F172A;
  font-weight: 700;
}

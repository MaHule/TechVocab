/** miniprogram/pages/article-list/article-list.wxss **/
/* 分类文章列表页面样式 (Clean Light 极简浅色规范) */

.page-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #F8FAFC;
  overflow: hidden;
  position: relative;
}

/* ==================== 1. 自定义顶部导航栏 ==================== */
.custom-nav {
  width: 100%;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #F1F5F9;
  z-index: 10;
  flex-shrink: 0;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0F172A;
  letter-spacing: -0.5rpx;
  max-width: 380rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-capsule-spacer {
  width: 160rpx; /* 微信胶囊占位 */
}

/* ==================== 2. 主体滚动区 ==================== */
.list-scroll {
  flex: 1;
  height: 0;
}

.scroll-inner {
  padding: 24rpx 32rpx;
}

/* ==================== 2.1 分类概览 Hero 看板 ==================== */
.category-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.03);
  margin-bottom: 20rpx;
}

.hero-left {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.hero-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #0F172A;
}

.hero-meta {
  font-size: 22rpx;
  color: #64748B;
}

.hero-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.hero-percent {
  font-size: 24rpx;
  font-weight: 800;
  color: #2563EB;
}

.hero-bar-track {
  width: 90rpx;
  height: 10rpx;
  background: #F1F5F9;
  border-radius: 5rpx;
  overflow: hidden;
}

.hero-bar-fill {
  height: 100%;
  background: #2563EB;
  border-radius: 5rpx;
  transition: width 0.3s ease;
}

/* ==================== 2.2 状态筛选胶囊 (Filter Pills) ==================== */
.filter-pills-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.pill-item {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.pill-item.active {
  background: #0F172A;
  border-color: #0F172A;
}

.pill-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #475569;
}

.pill-item.active .pill-text {
  color: #FFFFFF;
  font-weight: 700;
}

.pill-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.dot-reading {
  background: #D97706;
}

.dot-mastered {
  background: #059669;
}

.dot-unread {
  background: #94A3B8;
}

.pill-hover {
  opacity: 0.85;
}

/* ==================== 2.3 文章卡片流 ==================== */
.articles-stream {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.article-card {
  background: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.03);
  position: relative;
  overflow: hidden;
  transition: all 0.15s ease;
}

.card-hover {
  transform: scale(0.985);
  opacity: 0.95;
}

.reading-indicator-bar {
  position: absolute;
  left: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 6rpx;
  background: #0F172A;
  border-radius: 0 3rpx 3rpx 0;
}

.card-inner {
  display: flex;
  flex-direction: column;
}

.card-tag-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.tag-left-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-badge {
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.badge-reading {
  background: #FFFBEB;
  color: #D97706;
  border: 1rpx solid #FDE68A;
}

.badge-mastered {
  background: #ECFDF5;
  color: #059669;
  border: 1rpx solid #A7F3D0;
}

.badge-unread {
  background: #F1F5F9;
  color: #64748B;
  border: 1rpx solid #E2E8F0;
}

.spec-tag {
  background: #EFF6FF;
  color: #2563EB;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.time-meta {
  font-size: 22rpx;
  color: #94A3B8;
}

.article-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #0F172A;
  line-height: 1.35;
  margin-bottom: 10rpx;
}

.article-summary {
  font-size: 24rpx;
  color: #475569;
  line-height: 38rpx;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.card-bottom-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.vocab-pills-group {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.term-pill {
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  color: #334155;
  font-size: 20rpx;
  font-weight: 600;
  font-family: 'JetBrains Mono', monospace;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.action-link {
  font-size: 22rpx;
  font-weight: 600;
  color: #64748B;
  flex-shrink: 0;
}

.action-link.link-bold {
  font-weight: 700;
  color: #0F172A;
}

.empty-box {
  padding: 80rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 24rpx;
  color: #94A3B8;
}

.bottom-spacer {
  height: 60rpx;
}
